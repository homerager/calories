{
  "name": "calorie-counter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nuxt build",
    "dev": "nuxt dev --port 3001",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 3001",
    "start": "node --import ./server-preload.mjs .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:embed": "tsx scripts/backfill-embeddings.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "chart.js": "^4.5.1",
    "nuxt": "^4.0.0",
    "nuxt-auth-utils": "^0.5.30",
    "pg": "^8.23.0",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
