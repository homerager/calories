// Prisma schema — Calories
// Prisma ORM 7: новий генератор `prisma-client` (TS), драйвер-адаптер @prisma/adapter-pg.
// Конфіг CLI (schema/migrations/seed/datasource) — у prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "./generated/client"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY // сидячий спосіб життя
  LIGHT // легка активність (1-3 тренування/тиждень)
  MODERATE // помірна (3-5)
  ACTIVE // висока (6-7)
  VERY_ACTIVE // дуже висока / фізична робота
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum FoodSource {
  AI
  USER
  MANUAL
}

enum MealSource {
  AI_PHOTO
  AI_TEXT
  MANUAL
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GEMINI
}

enum AiRequestKind {
  TEXT
  IMAGE
  MENU
}

// Прийом їжі (для майбутнього групування записів по слотах)
enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// ─────────────────────────────────────────────────────────────
// Core: користувач та звʼязки
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Хеш пароля (scrypt через nuxt-auth-utils). Null, якщо лише OAuth.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        Profile?
  weightLogs     WeightLog[]
  mealEntries    MealEntry[]
  dailyTotals    DailyAggregate[]
  aiKeys         UserAiKey[]
  aiSetting      UserAiSetting?
  aiRequestsLogs AiRequestsLog[]
  freeQuota      FreeQuota?
  oauthAccounts  OAuthAccount[]
  // Стаби (див. нижче)
  waterLogs      WaterLog[]
  exerciseLogs   ExerciseLog[]
  reminders      Reminder[]
  menuPlans      MenuPlan[]

  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  @@index([email])
}

// OAuth-звʼязки (Google, GitHub, ...)
model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String // "google" | "github" | ...
  providerUserId String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Profile {
  id            String        @id @default(cuid())
  userId        String        @unique
  name          String?
  sex           Sex?
  birthDate     DateTime?
  age           Int? // денормалізований вік (fallback, якщо немає birthDate)
  activityLevel ActivityLevel @default(SEDENTARY)
  goal          Goal          @default(MAINTAIN)

  // Чутливі виміри — шифруються at rest (AES-256-GCM), формат iv:tag:ciphertext.
  heightEnc String? // зріст, см
  weightEnc String? // поточна вага, кг

  // Розраховані добові норми (Міффлін-Сан Жеор → TDEE → корекція за ціллю).
  dailyKcal    Int?
  proteinGrams Int?
  fatGrams     Int?
  carbGrams    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Історія зважувань (окремо від поточної ваги у Profile).
model WeightLog {
  id         String   @id @default(cuid())
  userId     String
  weightEnc  String // шифр ваги (кг)
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
}

// ─────────────────────────────────────────────────────────────
// Їжа: довідник + записи
// ─────────────────────────────────────────────────────────────

model FoodItem {
  id           String     @id @default(cuid())
  name         String // відображувана назва
  normalizedKey String    @unique // нормалізований ключ для пошуку схожих (lower/trim/без пунктуації)
  source       FoodSource @default(AI)

  // Поживність на 100 г
  kcalPer100    Float
  proteinPer100 Float
  fatPer100     Float
  carbPer100    Float

  // Embedding назви для семантичного пошуку (pgvector). Пишеться/читається
  // лише через raw SQL — Prisma не вміє тип vector. Розмірність 1536.
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mealEntries MealEntry[]
  menuItems   MenuItem[]

  @@index([name])
}

model MealEntry {
  id           String     @id @default(cuid())
  userId       String
  foodItemId   String?
  date         DateTime // день прийому (нормалізований до дати)
  slot         MealSlot?
  portionGrams Float

  // Знімок поживності на момент запису (щоб зміни у довіднику не ламали історію).
  kcal    Float
  protein Float
  fat     Float
  carb    Float

  source     MealSource @default(MANUAL)
  confidence Float? // впевненість AI (0..1)
  rawAiJson  Json? // сирий JSON-відповіді AI (для дебагу/аудиту)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([foodItemId])
}

// Денний агрегат (перерахунок при зміні MealEntry).
model DailyAggregate {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime // нормалізований до дати
  totalKcal    Float    @default(0)
  totalProtein Float    @default(0)
  totalFat     Float    @default(0)
  totalCarb    Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────
// AI: ключі користувачів, логи, квота
// ─────────────────────────────────────────────────────────────

model UserAiKey {
  id           String     @id @default(cuid())
  userId       String
  provider     AiProvider
  encryptedKey String // AES-256-GCM (iv:tag:ciphertext)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// Персональні налаштування AI користувача. Значення null → береться база з env.
model UserAiSetting {
  id     String @id @default(cuid())
  userId String @unique

  // Бажаний провайдер за замовчуванням (null → базовий із env при fallback).
  preferredProvider AiProvider?

  // Перевизначення моделей per-provider (null → базова модель із env).
  openaiModel    String?
  anthropicModel String?
  geminiModel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiRequestsLog {
  id               String        @id @default(cuid())
  userId           String
  provider         AiProvider
  model            String
  kind             AiRequestKind
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  cacheHit         Boolean       @default(false)
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Fallback безкоштовних запитів на сервісному ключі.
model FreeQuota {
  id          String   @id @default(cuid())
  userId      String   @unique
  usedCount   Int      @default(0)
  periodStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Меню на тиждень: збережений план + позиції по днях/слотах.
// ─────────────────────────────────────────────────────────────

model MenuPlan {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime // початок тижня (нормалізований до дати)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([userId, createdAt])
}

model MenuItem {
  id           String   @id @default(cuid())
  planId       String
  dayIndex     Int // 0..6 (Пн..Нд від startDate)
  slot         MealSlot
  name         String
  portionGrams Float
  kcal         Float
  protein      Float
  fat          Float
  carb         Float
  foodItemId   String? // привʼязка до довідника, якщо страва знайома
  // Кеш AI-деталей страви (інгредієнти/кроки/поради). Генерується за запитом.
  detailsJson  Json?

  plan     MenuPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([planId, dayIndex])
  @@index([foodItemId])
}

// ─────────────────────────────────────────────────────────────
// Стаби (архітектурний заділ): вода, вправи, нагадування.
// Мінімальні поля; UI поки прихований.
// ─────────────────────────────────────────────────────────────

model WaterLog {
  id         String   @id @default(cuid())
  userId     String
  volumeMl   Int
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
}

model ExerciseLog {
  id            String   @id @default(cuid())
  userId        String
  name          String
  durationMin   Int?
  steps         Int?
  kcalBurned    Int?
  performedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, performedAt])
}

enum ReminderKind {
  MEAL
  WATER
  WEIGH_IN
  CUSTOM
}

model Reminder {
  id         String       @id @default(cuid())
  userId     String
  kind       ReminderKind @default(CUSTOM)
  message    String? // довільний текст; якщо null — дефолтний підпис за kind
  timeOfDay  String // "HH:mm"
  daysOfWeek Int[]        @default([]) // 0=Нд..6=Сб (JS Date#getDay); порожньо = щодня
  enabled    Boolean      @default(true)
  lastSentAt DateTime? // коли востаннє відправлено сповіщення (дедуп у планувальнику)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Підписки Web Push (по одній на браузер/пристрій).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// In-app сповіщення (журнал спрацювань нагадувань).
model Notification {
  id         String    @id @default(cuid())
  userId     String
  reminderId String?
  title      String
  body       String?
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
